<%- include("../partials/header") %>

<section class="page-heading">
    <div>
        <p class="eyebrow">
            User Management
        </p>

        <h1>Edit User</h1>

        <p>
            Update account details, role, or status.
        </p>
    </div>

    <a href="/users" class="secondary-link">
        ← Back to users
    </a>
</section>

<section class="form-card">
    <% if (errorMessage) { %>
        <div class="alert alert-error">
            <span><%= errorMessage %></span>
        </div>
    <% } %>

    <form
        method="POST"
        action="/users/edit/<%= user.user_id %>"
    >
        <div class="form-section">
            <div class="form-section-heading">
                <h2>Account information</h2>

                <p>
                    Editing user ID:
                    <strong><%= user.user_id %></strong>
                </p>
            </div>

            <div class="form-grid">
                <div class="form-group full-width">
                    <label for="full_name">
                        Full name
                        <span class="required">*</span>
                    </label>

                    <input
                        type="text"
                        id="full_name"
                        name="full_name"
                        value="<%= user.full_name %>"
                        autocomplete="name"
                        required
                    >
                </div>

                <div class="form-group full-width">
                    <label for="email_address">
                        Email address
                        <span class="required">*</span>
                    </label>

                    <input
                        type="email"
                        id="email_address"
                        name="email_address"
                        value="<%= user.email_address %>"
                        autocomplete="email"
                        required
                    >
                </div>

                <div class="form-group">
                    <label for="role_id">
                        Role
                        <span class="required">*</span>
                    </label>

                    <select
                        id="role_id"
                        name="role_id"
                        required
                    >
                        <option value="">
                            Select a role
                        </option>

                        <% roles.forEach(role => { %>
                            <option
                                value="<%= role.role_id %>"
                                <%=
                                    String(user.role_id) ===
                                    String(role.role_id)
                                        ? "selected"
                                        : ""
                                %>
                            >
                                <%= role.role_name %>
                            </option>
                        <% }) %>
                    </select>
                </div>

                <div class="form-group">
                    <label for="is_active">
                        Account status
                    </label>

                    <select
                        id="is_active"
                        name="is_active"
                    >
                        <option
                            value="1"
                            <%=
                                Number(user.is_active) === 1
                                    ? "selected"
                                    : ""
                            %>
                        >
                            Active
                        </option>

                        <option
                            value="0"
                            <%=
                                Number(user.is_active) === 0
                                    ? "selected"
                                    : ""
                            %>
                        >
                            Inactive
                        </option>
                    </select>
                </div>
            </div>
        </div>

        <div class="form-actions">
            <a href="/users" class="cancel-button">
                Cancel
            </a>

            <button type="submit" class="primary-button">
                Save changes
            </button>
        </div>
    </form>
</section>

<%- include("../partials/footer") %>