<%- include("../partials/header") %>

<section class="page-heading">
    <div>
        <p class="eyebrow">Role Management</p>

        <h1>Edit Role</h1>

        <p>
            Update the role name or description.
        </p>
    </div>

    <a href="/roles" class="secondary-link">
        ← Back to roles
    </a>
</section>

<section class="form-card">
    <% if (errorMessage) { %>
        <div class="alert alert-error">
            <%= errorMessage %>
        </div>
    <% } %>

    <form
        method="POST"
        action="/roles/edit/<%= role.role_id %>"
    >
        <div class="form-section">
            <div class="form-section-heading">
                <h2>Role information</h2>

                <p>
                    This role is currently assigned to
                    <strong>
                        <%= userCount %>
                        <%= userCount === 1 ? "user" : "users" %>
                    </strong>.
                </p>
            </div>

            <div class="form-grid">
                <div class="form-group full-width">
                    <label for="role_name">
                        Role name
                        <span class="required">*</span>
                    </label>

                    <input
                        type="text"
                        id="role_name"
                        name="role_name"
                        value="<%= role.role_name %>"
                        maxlength="100"
                        required
                    >
                </div>

                <div class="form-group full-width">
                    <label for="role_description">
                        Description
                    </label>

                    <textarea
                        id="role_description"
                        name="role_description"
                        rows="5"
                    ><%= role.role_description || "" %></textarea>
                </div>
            </div>
        </div>

        <div class="form-actions">
            <a href="/roles" class="cancel-button">
                Cancel
            </a>

            <button type="submit" class="primary-button">
                Save changes
            </button>
        </div>
    </form>
</section>

<%- include("../partials/footer") %>