<%- include("../partials/header") %>

<section class="page-heading">
    <div>
        <p class="eyebrow">Work</p>
        <h1>Tasks</h1>

        <p>
            Create, assign, and track work across
            your organization.
        </p>
    </div>

    <a href="/tasks/add" class="button-link">
        + Add task
    </a>
</section>

<% if (successMessage) { %>
    <div class="alert alert-success">
        <%= successMessage %>
    </div>
<% } %>

<% if (errorMessage) { %>
    <div class="alert alert-error">
        <%= errorMessage %>
    </div>
<% } %>

<section class="content-card">
    <div class="section-heading">
        <div>
            <p class="eyebrow">Task directory</p>
            <h2>Organization tasks</h2>
        </div>

        <span class="record-count">
            <%= tasks.length %>
            <%= tasks.length === 1 ? "task" : "tasks" %>
        </span>
    </div>

    <% if (tasks.length === 0) { %>
        <div class="empty-state">
            <h3>No tasks found</h3>
            <p>Create your first task.</p>

            <a href="/tasks/add" class="button-link">
                Add task
            </a>
        </div>
    <% } else { %>
        <div class="table-wrapper">
            <table>
                <thead>
                    <tr>
                        <th>Task</th>
                        <th>Workspace</th>
                        <th>Priority</th>
                        <th>Status</th>
                        <th>Assignees</th>
                        <th>Due date</th>
                        <th class="actions-column">
                            Actions
                        </th>
                    </tr>
                </thead>

                <tbody>
                    <% tasks.forEach(task => { %>
                        <tr>
                            <td>
                                <a
                                    href="/tasks/<%= task.task_id %>"
                                    class="table-title-link"
                                >
                                    <%= task.task_title %>
                                </a>
                            </td>

                            <td>
                                <%= task.workspace_name %>
                            </td>

                            <td>
                                <span
                                    class="badge priority-<%=
                                        task.task_priority
                                            .toLowerCase()
                                    %>"
                                >
                                    <%= task.task_priority %>
                                </span>
                            </td>

                            <td>
                                <span
                                    class="badge task-status-<%=
                                        task.task_status
                                            .toLowerCase()
                                            .replaceAll(" ", "-")
                                    %>"
                                >
                                    <%= task.task_status %>
                                </span>
                            </td>

                            <td>
                                <%= task.assignee_count %>
                            </td>

                            <td>
                                <%= task.due_date ||
                                    "No deadline" %>
                            </td>

                            <td class="actions-column">
                                <div class="table-actions">
                                    <a
                                        href="/tasks/<%= task.task_id %>"
                                        class="small-button secondary-button"
                                    >
                                        View
                                    </a>

                                    <a
                                        href="/tasks/edit/<%= task.task_id %>"
                                        class="small-button secondary-button"
                                    >
                                        Edit
                                    </a>

                                    <form
                                        method="POST"
                                        action="/tasks/<%= task.task_id %>/delete"
                                        class="inline-form"
                                    >
                                        <button
                                            type="submit"
                                            class="small-button danger-button"
                                            data-confirm-task-delete
                                            data-task-title="<%= task.task_title %>"
                                            data-submission-count="<%= task.submission_count %>"
                                        >
                                            Delete
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    <% } %>
</section>

<%- include("../partials/footer") %>