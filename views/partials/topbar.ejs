<header class="topbar">
    <div class="topbar-left">
        <button
            type="button"
            class="sidebar-toggle"
            id="sidebarToggle"
            aria-label="Toggle sidebar"
        >
            ☰
        </button>

        <div class="breadcrumb">
            <a href="/dashboard">
                Workflow Platform
            </a>

            <span>/</span>

            <strong>
                <%= pageTitle %>
            </strong>
        </div>
    </div>

    <div class="topbar-right">
        <button
            type="button"
            class="icon-button"
            aria-label="Notifications"
        >
            🔔
        </button>

        <div class="organization-name">
            Demo Organization
        </div>
    </div>
</header>